  heading1 String? @db.VarChar(200)
  desc1    String? @db.Text
  banner1  String? @db.VarChar(200)
  heading2 String? @db.VarChar(200)
  desc2    String? @db.Text
  heading3 String? @db.VarChar(200)
  banner2  String? @db.VarChar(200)
  banner3  String? @db.VarChar(200)
  heading4 String? @db.VarChar(200)
  banner4  String? @db.VarChar(200)
  desc3    String? @db.Text
  heading5 String? @db.VarChar(200)
  banner5  String? @db.Text
  desc4    String? @db.Text
  desc5    String? @db.Text
  seoDesc  String? @map("seo_desc") @db.LongText
  seoKey   String? @map("seo_key") @db.LongText
  seoTitle String? @map("seo_title") @db.VarChar(500)

  @@map("wid_wid")
}

enum WidProductImageStatus {
  active
  draft
}
