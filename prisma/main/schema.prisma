  client2         String? @db.VarChar(100)
  clientImg2      String? @map("client_img2") @db.VarChar(100)
  reviewDesc3     String? @map("review_desc3") @db.Text
  client3         String? @db.VarChar(100)
  clientImg3      String? @map("client_img3") @db.VarChar(100)
  whyChoose       String? @map("why_choose") @db.VarChar(500)
  whyChooseDec    String? @map("why_choose_dec") @db.Text
  chose1          String? @db.VarChar(500)
  chose2          String? @db.VarChar(500)
  chose3          String? @db.VarChar(500)
  chose4          String? @db.VarChar(500)
  chose5          String? @db.VarChar(500)
  chose6          String? @db.VarChar(500)
  chose7          String? @db.VarChar(500)
  chose8          String? @db.VarChar(500)
  chose9          String? @db.VarChar(500)
  chose10         String? @db.VarChar(500)
  banner2         String? @db.VarChar(100)
  ab2Heading      String? @map("ab2_heading") @db.VarChar(100)
  ab2Desc1        String? @map("ab2_desc1") @db.Text
  ab2Desc2        String? @map("ab2_desc2") @db.Text
  ab2Desc3        String? @map("ab2_desc3") @db.Text
  ab2Desc4        String? @map("ab2_desc4") @db.Text
  ab2Desc5        String? @map("ab2_desc5") @db.Text
  ab2Slid1        String? @map("ab2_slid1") @db.VarChar(100)
  ab2Slid2        String? @map("ab2_slid2") @db.VarChar(100)
  ab2Slid3        String? @map("ab2_slid3") @db.VarChar(100)
  phHeading       String? @map("ph_heading") @db.VarChar(200)
  phDesc          String? @map("ph_desc") @db.Text
  banner3         String? @db.VarChar(100)
  seoDesc         String? @map("seo_desc") @db.LongText
  seoKey          String? @map("seo_key") @db.LongText
  seoTitle        String? @map("seo_title") @db.VarChar(500)

  @@map("wid_home")
