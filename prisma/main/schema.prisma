generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/main"
}

datasource db {
  provider = "mysql"
  url      = env("MAIN_DATABASE_URL")
}

model WidAdmin {
  id        Int    @id @default(autoincrement()) @db.Int
  adminName String @map("admin_name") @db.VarChar(20)
  email     String @db.VarChar(50)
  pass      String @db.VarChar(2100)
  loginTime String @map("login_time") @db.VarChar(225)
  ip        String @db.VarChar(225)

  @@map("wid_admin")
}

model WidCon {
  id       Int     @id @default(autoincrement()) @db.Int
  descText String  @map("desc_text") @db.Text
  image    String? @db.VarChar(500)
  title    String? @db.VarChar(500)

  @@map("wid_con")
}

model WidContact {
  id          Int     @id @default(autoincrement()) @db.Int
  slid1       String? @db.VarChar(100)
  slid2       String? @db.VarChar(100)
  slid3       String? @db.VarChar(100)
  mainHeading String? @map("main_heading") @db.VarChar(100)
  heading2    String? @db.VarChar(100)
  desc1       String? @db.Text
  banner1     String? @db.VarChar(100)
  slid21      String? @db.Text
  desc21      String? @db.Text
  img21       String? @db.Text
  slid22      String? @db.VarChar(100)
  desc22      String? @db.Text
  img22       String? @db.VarChar(100)
  slid23      String? @db.VarChar(100)
  desc23      String? @db.Text
  img23       String? @db.VarChar(100)
  banner2     String? @db.VarChar(100)
  seoDesc     String? @map("seo_desc") @db.LongText
  seoKey      String? @map("seo_key") @db.LongText
  seoTitle    String? @map("seo_title") @db.VarChar(500)

  @@map("wid_contact")
}

model WidFooter {
  id        Int     @id @default(autoincrement()) @db.Int
  facbook   String? @db.VarChar(100)
  instagram String? @db.VarChar(100)
  twitter   String? @db.VarChar(100)
  linkidn   String? @db.VarChar(100)
  youtube   String? @db.VarChar(100)
  tumblr    String? @db.VarChar(100)
  heading1  String? @db.VarChar(100)
  heading2  String? @db.VarChar(100)
  address   String? @db.VarChar(2000)
  mobile    String? @db.VarChar(100)
  email1    String? @db.VarChar(100)
  email2    String? @db.VarChar(100)
  copyright String? @db.VarChar(500)

  @@map("wid_footer")
}

model WidGallery {
  id       Int     @id @default(autoincrement()) @db.Int
  heading  String? @db.VarChar(100)
  descr    String? @db.Text
  banner   String? @db.VarChar(100)
  heading2 String? @db.VarChar(100)
  descr2   String? @db.Text
  heading3 String? @db.VarChar(500)
  descr4   String? @db.Text
  seoDesc  String? @map("seo_desc") @db.LongText
  seoKey   String? @map("seo_key") @db.LongText
  seoTitle String? @map("seo_title") @db.VarChar(500)

  @@map("wid_gallery")
}

