model WidHomeGallery {
  id         Int     @id @default(autoincrement()) @db.Int
  title      String? @db.VarChar(100)
  buttonName String? @map("button_name") @db.VarChar(100)
  url        String? @db.VarChar(500)

  @@map("wid_home_gallery")
}

model WidPreWeddingPage {
  id       Int     @id @default(autoincrement()) @db.Int
  heading1 String? @db.VarChar(100)
  disc1    String? @db.Text
  banner1  String? @db.VarChar(100)
  heading2 String? @db.VarChar(100)
  desc2    String? @db.Text
  heading3 String? @db.VarChar(100)
  banner2  String? @db.VarChar(100)
  desc3    String? @db.Text
  banner3  String? @db.VarChar(100)
