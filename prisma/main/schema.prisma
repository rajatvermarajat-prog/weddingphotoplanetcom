model WidProduct {
  id          Int     @id @default(autoincrement()) @db.Int
  pageSlug    String? @map("page_slug") @db.VarChar(500)
  productName String? @map("product_name") @db.VarChar(100)
  category    String? @db.VarChar(100)
  heroImg     String? @map("hero_img") @db.VarChar(200)
  heading1    String? @db.VarChar(100)
  desc1       String? @db.LongText
  banner1     String? @db.VarChar(100)
  heading2    String? @db.VarChar(200)
  desc2       String? @db.LongText
  heading3    String? @db.VarChar(200)
  desc3       String? @db.LongText
  banner2     String? @db.Text
  desc4       String? @db.Text
  seoDesc     String? @map("seo_desc") @db.LongText
  seoKey      String? @map("seo_key") @db.LongText
  seoTitle    String? @map("seo_title") @db.VarChar(500)

  @@map("wid_product")
}

model WidProductImage {
  id     Int                   @id @default(autoincrement()) @db.Int
  pid    String                @db.VarChar(100)
  name   String                @db.LongText
  type   String                @db.LongText
  altImg String?               @map("alt_img") @db.LongText
  status WidProductImageStatus @default(draft)

  @@map("wid_product_image")
}

model WidProductSlider {
  id        Int     @id @default(autoincrement()) @db.Int
  imageName String? @map("image_name") @db.VarChar(200)
  pid       String? @db.VarChar(11)

  @@map("wid_product_slider")
}

model WidSlide {
  id         Int     @id @default(autoincrement()) @db.Int
  parantId   String? @map("parant_id") @db.VarChar(100)
  parantName String? @map("parant_name") @db.VarChar(50)
  imageName  String? @map("image_name") @db.VarChar(500)

  @@map("wid_slide")
}

model WidTestimonial {
  id         Int     @id @default(autoincrement()) @db.Int
  descText   String? @map("desc_text") @db.Text
  clientName String? @map("client_name") @db.VarChar(200)
  image      String? @db.VarChar(500)

  @@map("wid_testimonial")
}

model WidVideo {
  id   Int     @id @default(autoincrement()) @db.Int
  name String? @db.VarChar(500)
